<?xml version="1.0" encoding="UTF-8"?>
<!--
  local_manifests/gts7fewifi.xml — Evolution X (bka / Android 16) build
  for gts7fewifi (Galaxy Tab S7 FE Wi-Fi, SM-T733)

  Setup:
      repo init -u https://github.com/Evolution-X/manifest -b bka   (enable git-lfs)
      mkdir -p .repo/local_manifests
      cp this file .repo/local_manifests/gts7fewifi.xml
      repo sync -c -j$(nproc)   # add the usual force/no-clone-bundle/no-tags flags
      . build/envsetup.sh
      lunch evolution_gts7fewifi-bp4a-userdebug   # or: lunch evolution_gts7fewifi-userdebug
      m evolution

  Why these pins (see docs/verified-source-map.md):
   - bka is Evolution X's Android 16 branch (android-16.0.0_r4 + lineage-23.2),
     matching this device tree's LineageOS 23.2 base. (cnb = Android 17.)
   - The kernel must be Bush-cat's lineage-22.1-gts7fewifi branch: it is the
     only public branch with vendor/lineage-gts7fewifi_defconfig and the
     wacom/w90xx + focaltech ft820x drivers. If you pushed
     patches/kernel/*.patch to your own kernel fork, point this entry at
     your fork instead.
   - vendor/lineage (Evolution X's vendor tree) comes from the EvoX manifest
     itself; do NOT add LineageOS's vendor/lineage here.
   - device/samsung/sm7325-common and its dependencies (hardware/samsung,
     hardware/samsung_slsi/nfc, kernel) are resolved via lineage.dependencies
     — the roomservice-added kernel entry must be removed in favour of the
     pinned one below (delete the duplicate path entry from
     .repo/local_manifests/roomservice.xml after first breakfast, if repo
     complains).
-->
<manifest>
  <remote name="bushcat"
          fetch="https://github.com/Bush-cat"
          revision="lineage-23.2" />

  <!-- Kernel (only public branch that can build this device) -->
  <project path="kernel/samsung/sm7325"
           name="android_kernel_samsung_sm7325"
           remote="bushcat"
           revision="lineage-22.1-gts7fewifi" />

  <!-- Device tree (this repo / its upstream) -->
  <project path="device/samsung/gts7fewifi"
           name="android_device_samsung_gts7fewifi"
           remote="bushcat"
           revision="lineage-23.2" />

  <!-- Vendor blobs -->
  <project path="vendor/samsung/gts7fewifi"
           name="proprietary_vendor_samsung_gts7fewifi"
           remote="bushcat"
           revision="lineage-23.2-temp" />

  <project path="vendor/samsung/sm7325-common"
           name="proprietary_vendor_samsung_sm7325-common"
           remote="bushcat"
           revision="lineage-23.2" />
</manifest>
